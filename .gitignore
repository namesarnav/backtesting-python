__pycache__/
*.pyc
.venv/
venv/
# The per-ticker price cache IS committed: Yahoo blocks scripted clients, so a
# fresh clone could not fetch it, and the Phase 8 checkpoint requires one
# Docker command to reproduce the results. ~2.8MB for 41 tickers x 5 years.
# The panel-level caches are pure derivations of those files (rebuilt in
# ~0.1s), so they stay ignored.
data/cache/panel_*.parquet
data/*.parquet
# notebooks/results/*.png is deliberately NOT ignored: the README embeds
# these charts, and Phase 8 requires a clone to show them without a rebuild.
notebooks/results/*.html
.pytest_cache/
.ipynb_checkpoints/
*.egg-info/
.DS_Store
# C++ extension build artifacts (Phase 7). The .so is platform-specific
# and rebuilt by `python setup.py build_ext --inplace`, so it stays out.
build/
*.so
data/*.json
